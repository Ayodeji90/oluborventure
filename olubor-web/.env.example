# ---------------------------------------------------------------------------
# Appwrite — copy this file to `.env.local` and fill in the values.
#
#   1. Create a project at https://cloud.appwrite.io
#   2. Settings -> API keys -> create a key with:
#        databases.read, databases.write, storage.read, storage.write,
#        users.read, users.write, teams.read, teams.write
#   3. Settings -> Platforms -> add a Web platform:
#        hostname  localhost        (add your production domain too)
#   4. Run `npm run provision` to create the database, tables and bucket.
# ---------------------------------------------------------------------------

# --- server only (never expose the key) ---
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=

# --- safe to expose to the browser ---
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=olubor
NEXT_PUBLIC_APPWRITE_BUCKET_ID=application-documents

# --- server-side ids (default to the same values as above) ---
APPWRITE_DATABASE_ID=olubor
APPWRITE_BUCKET_ID=application-documents
