# Supabase — copy this to .env.local and fill in your project values
# Find these at: supabase.com → your project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend — for contact form email notifications
# Get your API key at: resend.com → API Keys
RESEND_API_KEY=re_your-api-key-here
# Email address that receives contact form notifications
CONTACT_NOTIFY_EMAIL=info@oluborconsults.com
